<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ e.commonName }} ({{ e.scientificName }}) — The Burren Scriptorium</title>
<meta name="description" content="{{ e.description }}">
<link rel="canonical" href="{{ canonical }}">

<meta property="og:title" content="{{ e.commonName }} — The Burren Scriptorium">
<meta property="og:description" content="{{ e.description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:site_name" content="The Burren Scriptorium">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ e.commonName }} — The Burren Scriptorium">
<meta name="twitter:description" content="{{ e.description }}">

<link rel="stylesheet" href="../../assets/scriptorium.css">
<script type="application/ld+json">{{ jsonld }}</script>
</head>
<body>
<nav class="scriptorium-nav">
  <a class="brand" href="../../index.html">The Burren Scriptorium</a>
  <div class="crumbs"><a href="../index.html">Flora</a> &nbsp;/&nbsp; {{ e.commonName }}</div>
  <div class="nav-actions">
    <button class="search-trigger" id="searchTrigger">Search <kbd>&#8984;K</kbd></button>
  </div>
</nav>

<div class="ambient-backdrop"><svg viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice"></svg></div>

<main class="entry-page">
  <div class="entry-header">
    <h1>{{ e.commonName }}</h1>
    <button class="play-pronunciation" id="pronounceBtn" title="Hear pronunciation (synthesized speech)" aria-label="Hear pronunciation">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 9v6h4l5 5V4L8 9H4Z"/></svg>
    </button>
  </div>
  <p class="scientific-name">{{ e.scientificName }}</p>
  {% if e.oghamName %}
  <div class="ogham-name">{{ e.oghamName }}</div>
  <div class="ogham-gloss">({{ e.oghamGloss }})</div>
  {% endif %}

  <div class="badge-row">
    <span class="badge">Flora &mdash; {{ e.category }}</span>
    {% for h in e.habitatTags %}<span class="badge habitat">{{ h }}</span>{% endfor %}
  </div>

  <div class="entry-body-grid">
    <div class="specimen-stage">{{ specimen_svg }}</div>
    <div>
      <p class="entry-prose">{{ e.description }}</p>
      {% if e.habitatTags %}
      <div class="inferred-note">Habitat tag(s) above are inferred from the field-notes text above, not yet independently field-verified &mdash; flagged for review rather than stated as confirmed habitat data.</div>
      {% endif %}
      <div class="inferred-note">The pronunciation button uses your browser's built-in text-to-speech, not a recorded native speaker &mdash; a placeholder until real audio is sourced.</div>
    </div>
  </div>

  <a class="back-link" href="../index.html">&larr; Back to Flora</a>
</main>

<script src="../../assets/scriptorium-search.js"></script>
<script>
  ScriptoriumSearch.init({
    scriptoriumRootPrefix: '../../',
    dataUrls: ['../../data/flora-flowers-grasses.json'],
    entryLinkFn: function (e) { return '../../flora/' + e.slug + '/'; }
  });
  document.getElementById('searchTrigger').addEventListener('click', function () { ScriptoriumSearch.open(); });
  document.getElementById('pronounceBtn').addEventListener('click', function () {
    ScriptoriumCommon.speak({{ e.commonName | tojson }}, this);
  });
</script>
</body>
</html>
